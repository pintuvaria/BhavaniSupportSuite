<UserControl x:Class="BhavaniSupportSuite.Views.PatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#181824"
             Foreground="#E0E0E0">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Update Status -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Windows Update Status" Style="{StaticResource SectionTitle}" />
                    
                    <Border Background="#222232" CornerRadius="8" Padding="12" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding UpdateStatus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#E0E0E0" FontFamily="Consolas" FontSize="11" Margin="0,2" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Actions" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,12,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <Button Grid.Column="1" Content="Install Updates" Command="{Binding InstallUpdatesCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,12,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <Button Grid.Column="2" Content="View History" Command="{Binding ViewHistoryCommand}" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- Pending Updates -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Pending Updates" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding PendingUpdates.Count, StringFormat='{}{0} updates pending'}" Foreground="#888888" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <Border Background="#222232" CornerRadius="8" Padding="12" MaxHeight="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <DataGrid ItemsSource="{Binding PendingUpdates}" AutoGenerateColumns="False"
                                      Background="#222232" Foreground="#E0E0E0"
                                      BorderThickness="0" GridLinesVisibility="None"
                                      HeadersVisibility="Column" RowBackground="#222232"
                                      AlternatingRowBackground="#1E1E2E"
                                      CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="KB Article" Binding="{Binding KBArticle}" Width="100" />
                                    <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="150" />
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80" />
                                    <DataGridCheckBoxColumn Header="Downloaded" Binding="{Binding IsDownloaded}" Width="80" />
                                    <DataGridCheckBoxColumn Header="Installed" Binding="{Binding IsInstalled}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Update Log -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Update Log" Style="{StaticResource SectionTitle}" />
                    <Border Background="#222232" CornerRadius="6" Padding="12" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding UpdateLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#888888" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
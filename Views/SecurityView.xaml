<UserControl x:Class="BhavaniSupportSuite.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:views="clr-namespace:BhavaniSupportSuite.Views"
             
             Foreground="#E0E0E0" Background="#181824">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Security Status Cards -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Security Overview" Style="{StaticResource SectionTitle}" />
                    <UniformGrid Columns="4">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="USB Storage" Foreground="#888888" FontSize="11" />
                                <TextBlock Text="{Binding UsbStorageEnabled, Converter={StaticResource BoolToStatusConverter}}" Foreground="#E0E0E0" FontSize="16" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="BitLocker" Foreground="#888888" FontSize="11" />
                                <TextBlock Text="{Binding BitLockerEnabled, Converter={StaticResource BoolToStatusConverter}}" Foreground="#E0E0E0" FontSize="16" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Running Processes" Foreground="#888888" FontSize="11" />
                                <TextBlock Text="{Binding RunningProcesses.Count}" Foreground="#E0E0E0" FontSize="16" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Unsigned" Foreground="#888888" FontSize="11" />
                                <TextBlock Text="{Binding UnsignedBinaries.Count}" Foreground="#FFA502" FontSize="16" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Process Manager -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Process &amp; Startup Manager" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Processes" Command="{Binding LoadProcessesCommand}" Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Startup" Command="{Binding LoadStartupItemsCommand}" Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Tasks" Command="{Binding LoadScheduledTasksCommand}" Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Unsigned" Command="{Binding CheckUnsignedBinariesCommand}" Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Kill Process" Command="{Binding KillSelectedProcessCommand}" Style="{StaticResource DangerButtonStyle}" FontSize="11" Padding="10,4" />
                        </StackPanel>
                    </Grid>

                    <TabControl Margin="0,12,0,0" Background="#1E1E2E" Foreground="#E0E0E0">
                        <TabItem Header="Processes">
                            <Border Background="#1E1E2E" Padding="0,8">
                                <Border Background="#222232" CornerRadius="8" Padding="8" MaxHeight="300">
                                    <DataGrid ItemsSource="{Binding RunningProcesses}" AutoGenerateColumns="False" 
                                              Background="#222232" Foreground="#E0E0E0" BorderThickness="0" 
                                              GridLinesVisibility="None" HeadersVisibility="Column" 
                                              RowBackground="#222232" AlternatingRowBackground="#1E1E2E"
                                              CanUserAddRows="False" IsReadOnly="True" SelectedItem="{Binding SelectedProcessName}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="60" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Memory (MB)" Binding="{Binding MemoryMb}" Width="100" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Border>
                        </TabItem>
                        <TabItem Header="Startup Items">
                            <Border Background="#1E1E2E" Padding="0,8">
                                <Border Background="#222232" CornerRadius="8" Padding="8" MaxHeight="300">
                                    <DataGrid ItemsSource="{Binding StartupItems}" AutoGenerateColumns="False" 
                                              Background="#222232" Foreground="#E0E0E0" BorderThickness="0" 
                                              GridLinesVisibility="None" HeadersVisibility="Column" 
                                              RowBackground="#222232" AlternatingRowBackground="#1E1E2E"
                                              CanUserAddRows="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="120" />
                                            <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="300" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Border>
                        </TabItem>
                        <TabItem Header="Scheduled Tasks">
                            <Border Background="#1E1E2E" Padding="0,8">
                                <Border Background="#222232" CornerRadius="8" Padding="8" MaxHeight="300">
                                    <DataGrid ItemsSource="{Binding ScheduledTasks}" AutoGenerateColumns="False" 
                                              Background="#222232" Foreground="#E0E0E0" BorderThickness="0" 
                                              GridLinesVisibility="None" HeadersVisibility="Column" 
                                              RowBackground="#222232" AlternatingRowBackground="#1E1E2E"
                                              CanUserAddRows="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80" />
                                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="200" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Border>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>

            <!-- USB & BitLocker Controls -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Security Controls" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding UsbStorageEnabled, Converter={StaticResource UsbToggleConverter}}" Command="{Binding ToggleUsbStorageCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#888888" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="BhavaniSupportSuite.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            
             Background="#181824"
             Foreground="#E0E0E0">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Subnet Scanner -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Multi-Subnet Ping Sweep" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Subnet:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#888888" />
                        <TextBox Grid.Column="1" Text="{Binding TargetSubnet}" Width="200" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Start Scan"
                                Command="{Binding StartSubnetScanCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="12,0,0,0"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}" />
                        <Button Grid.Column="3" Content="Stop"
                                Command="{Binding StopScanCommand}"
                                Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0"
                                IsEnabled="{Binding IsScanning}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <ProgressBar Value="{Binding ScanProgress}" Maximum="100" Height="4" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding ScanStatus}"
                                   Style="{StaticResource StatusText}" Margin="0,6,0,0" />
                    </Grid>

                    <Border Background="#222232" CornerRadius="8" Padding="12" MaxHeight="300">
                        <DataGrid ItemsSource="{Binding ScanResults}" AutoGenerateColumns="False"
                                  Background="#222232" Foreground="#E0E0E0"
                                  BorderThickness="0" GridLinesVisibility="None"
                                  HeadersVisibility="Column" RowBackground="#222232"
                                  AlternatingRowBackground="#1E1E2E"
                                  CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="130" />
                                <DataGridTextColumn Header="Hostname" Binding="{Binding HostName}" Width="*" />
                                <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="150" />
                                <DataGridTextColumn Header="Response" Binding="{Binding ResponseTimeMs}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Port Scanner -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Port Testing Utility" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Target IP:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#888888" />
                        <TextBox Grid.Column="1" Text="{Binding TargetIp}" Width="200" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Scan Ports"
                                Command="{Binding ScanPortsCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="12,0,0,0"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ports:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#888888" />
                        <TextBox Grid.Column="1" Text="{Binding PortRange}" Width="*" />
                    </Grid>

                    <Border Background="#222232" CornerRadius="8" Padding="12" MaxHeight="250">
                        <DataGrid ItemsSource="{Binding PortResults}" AutoGenerateColumns="False"
                                  Background="#222232" Foreground="#E0E0E0"
                                  BorderThickness="0" GridLinesVisibility="None"
                                  HeadersVisibility="Column" RowBackground="#222232"
                                  AlternatingRowBackground="#1E1E2E"
                                  CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
                                <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Network Info -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="DHCP &amp; VLAN Diagnostic" Style="{StaticResource SectionTitle}" />
                        <Button Content="Load Network Info" HorizontalAlignment="Right"
                                Command="{Binding LoadNetworkInfoCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                    </Grid>

                    <Border Background="#222232" CornerRadius="6" Padding="12" MaxHeight="200">
                        <ItemsControl ItemsSource="{Binding NetworkInfo}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#888888"
                                               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="BhavaniSupportSuite.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:BhavaniSupportSuite.Views"
             mc:Ignorable="d"
             Foreground="{StaticResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Subnet Scanner -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Multi-Subnet Ping Sweep" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Subnet:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding TargetSubnet}" Width="200"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Start Scan"
                                Command="{Binding StartSubnetScanCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="12,0,0,0"
                                IsEnabled="{Binding IsScanning, Converter={x:Static views:InverseBoolConverter.Instance}}" />
                        <Button Grid.Column="3" Content="Stop"
                                Command="{Binding StopScanCommand}"
                                Background="{StaticResource DangerBrush}" Foreground="White"
                                BorderThickness="0" Height="40" Padding="16,0" Margin="8,0,0,0" Cursor="Hand"
                                IsEnabled="{Binding IsScanning}" />
                    </Grid>

                    <!-- Progress -->
                    <Grid Margin="0,0,0,12">
                        <ProgressBar Value="{Binding ScanProgress}" Maximum="{Binding ScanTotal}" Height="4" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding ScanStatus}"
                                   Style="{StaticResource StatusText}" Margin="0,6,0,0" />
                    </Grid>

                    <!-- Scan Results -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" MaxHeight="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <DataGrid ItemsSource="{Binding ScanResults}" AutoGenerateColumns="False"
                                      Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderThickness="0" GridLinesVisibility="None"
                                      HeadersVisibility="Column" RowBackground="{StaticResource CardBrush}"
                                      AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                      CanUserAddRows="False" IsReadOnly="True"
                                      SelectedItem="{Binding SelectedHost}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="130" />
                                    <DataGridTextColumn Header="Hostname" Binding="{Binding HostName}" Width="*" />
                                    <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="150" />
                                    <DataGridTextColumn Header="Response" Binding="{Binding ResponseTimeMs}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Port Scanner -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Port Testing Utility" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Target IP:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding TargetIp}" Width="200"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Scan Ports"
                                Command="{Binding ScanPortsCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="12,0,0,0"
                                IsEnabled="{Binding IsScanning, Converter={x:Static views:InverseBoolConverter.Instance}}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ports:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding PortRange}" Width="*" />
                    </Grid>

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" MaxHeight="250">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <DataGrid ItemsSource="{Binding PortResults}" AutoGenerateColumns="False"
                                      Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderThickness="0" GridLinesVisibility="None"
                                      HeadersVisibility="Column" RowBackground="{StaticResource CardBrush}"
                                      AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                      CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
                                    <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" />
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Network Info -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="DHCP &amp; VLAN Diagnostic" Style="{StaticResource SectionTitle}" />
                        <Button Content="Load Network Info" HorizontalAlignment="Right"
                                Command="{Binding LoadNetworkInfoCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{Binding IsScanning, Converter={x:Static views:InverseBoolConverter.Instance}}" />
                    </Grid>

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding NetworkInfo}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

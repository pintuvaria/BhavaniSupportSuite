<UserControl x:Class="BhavaniSupportSuite.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:views="clr-namespace:BhavaniSupportSuite.Views"
              xmlns:conv="clr-namespace:BhavaniSupportSuite.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#181824"
             Foreground="{StaticResource TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Remote Connection Launcher -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Remote Session Launcher" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Host:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding ConnectionHost}" Width="200" />
                        <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="3" Text="{Binding ConnectionPort}" Width="80" />
                        <ComboBox Grid.Column="4" SelectedItem="{Binding SelectedProtocol}" Width="80" Margin="12,0,0,0">
                            <sys:String>RDP</sys:String>
                            <sys:String>SSH</sys:String>
                            <sys:String>VNC</sys:String>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="User:" VerticalAlignment="Center" Margin="0,8,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding ConnectionUsername}" Width="200" Margin="0,8,0,0" />

                        <StackPanel Grid.Column="4" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="RDP" Command="{Binding LaunchRdpCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0" FontSize="11" Padding="12,4" />
                            <Button Content="SSH" Command="{Binding LaunchSshCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,6,0" FontSize="11" Padding="12,4" />
                            <Button Content="VNC" Command="{Binding LaunchVncCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,6,0" FontSize="11" Padding="12,4" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" />
                </StackPanel>
            </Border>

            <!-- Report Generation -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Enterprise Report Generator" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Generates PDF/HTML diagnostic summaries branded with Bhavani Technology." Style="{StaticResource StatusText}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Path:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding ReportPath}" />
                        <Button Grid.Column="2" Content="Diagnostic Report" Command="{Binding GenerateReportCommand}" Style="{StaticResource AccentButtonStyle}" Margin="12,0,0,0" IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                        <Button Grid.Column="3" Content="Service Receipt" Command="{Binding GenerateServiceReceiptCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="8,0,0,0" IsEnabled="{Binding IsBusy, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Saved Connections -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Saved Connections" Style="{StaticResource SectionTitle}" />
                        <Button Content="Save Current" Command="{Binding SaveConnectionCommand}" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="12,4" />
                    </Grid>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" MaxHeight="200">
                        <DataGrid ItemsSource="{Binding SavedConnections}" AutoGenerateColumns="False" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column" RowBackground="{StaticResource CardBrush}" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" />
                                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="120" />
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60" />
                                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="BhavaniSupportSuite.Views.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:BhavaniSupportSuite.Views"
             mc:Ignorable="d"
             Background="#181824"
             Foreground="{StaticResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Password Reset -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Local Password Reset Routine" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Username:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding TargetUsername}" Width="200" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Text="New Password:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <PasswordBox Grid.Column="1" Grid.Row="1" Width="200" x:Name="PasswordInput" />

                        <Button Grid.Column="2" Content="Reset Password"
                                Command="{Binding ResetPasswordCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="12,0,0,0"
                                IsEnabled="{Binding IsBusy, Converter={x:Static views:InverseBoolConverter.Instance}}" />
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" />
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Quick Actions" Style="{StaticResource SectionTitle}" />

                    <WrapPanel>
                        <Button Content="Generate Diagnostic Report"
                                Command="{Binding GenerateReportCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8"
                                IsEnabled="{Binding IsBusy, Converter={x:Static views:InverseBoolConverter.Instance}}" />
                        <Button Content="List Local Users"
                                Command="{Binding ListLocalUsersCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8"
                                IsEnabled="{Binding IsBusy, Converter={x:Static views:InverseBoolConverter.Instance}}" />
                        <Button Content="List Scheduled Tasks"
                                Command="{Binding ListScheduledTasksCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8"
                                IsEnabled="{Binding IsBusy, Converter={x:Static views:InverseBoolConverter.Instance}}" />
                        <Button Content="Control Panel"
                                Command="{Binding OpenControlPanelCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8" />
                        <Button Content="Device Manager"
                                Command="{Binding OpenDeviceManagerCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8" />
                        <Button Content="Disk Management"
                                Command="{Binding OpenDiskManagementCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8" />
                    </WrapPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Report Path:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding ReportPath}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Output Log -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Output Log" Style="{StaticResource SectionTitle}" />
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" MaxHeight="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OutputLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

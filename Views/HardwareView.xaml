<UserControl x:Class="BhavaniSupportSuite.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BhavaniSupportSuite.Views"
             Foreground="{StaticResource TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Thermal Monitor -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Thermal Monitor" Style="{StaticResource SectionTitle}" />
                    <UniformGrid Columns="3">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="CPU Temperature" Style="{StaticResource MetricLabel}" />
                                <TextBlock Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0">
                                    <Run Text="{Binding CpuTemperature, StringFormat={}{0:F1}\u00B0C}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding CpuTemperatureF, StringFormat={}{0:F1}\u00B0F}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Thermal Status" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding CpuTempStatus}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="SMART Health" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding SmartStatuses.Count, StringFormat={}{0} Drives}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Hardware Info -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Hardware Information" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Refresh" Command="{Binding RefreshHardwareCommand}" Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="12,4" Margin="0,0,8,0" />
                            <Button Content="Check SMART" Command="{Binding CheckSmartStatusCommand}" Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="12,4" Margin="0,0,8,0" />
                            <Button Content="Check Battery" Command="{Binding CheckBatteryCommand}" Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="12,4" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" MaxHeight="250">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <DataGrid ItemsSource="{Binding HardwareInfo}" AutoGenerateColumns="False" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column" RowBackground="{StaticResource CardBrush}" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Battery & Memory -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Battery Status" Style="{StaticResource SectionTitle}" />
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding BatteryInfo}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="SMART Status" Style="{StaticResource SectionTitle}" />
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <DataGrid ItemsSource="{Binding SmartStatuses}" AutoGenerateColumns="False" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column" RowBackground="{StaticResource CardBrush}" CanUserAddRows="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Drive" Binding="{Binding DriveName}" Width="*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                                        <DataGridTextColumn Header="Health" Binding="{Binding HealthPercent}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

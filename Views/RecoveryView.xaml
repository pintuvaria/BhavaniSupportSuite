<UserControl x:Class="BhavaniSupportSuite.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:views="clr-namespace:BhavaniSupportSuite.Views"
             
             mc:Ignorable="d"
             Background="#181824"
             Foreground="{StaticResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- User Audit -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Offline Security Audit" Style="{StaticResource SectionTitle}" />
                        <Button Content="Audit Local Users" HorizontalAlignment="Right"
                                Command="{Binding AuditLocalUsersCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12">
                        <DataGrid ItemsSource="{Binding LocalUsers}" AutoGenerateColumns="False"
                                  Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderThickness="0" GridLinesVisibility="None"
                                  HeadersVisibility="Column" RowBackground="{StaticResource CardBrush}"
                                  AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                  CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="Last Logon" Binding="{Binding LastLogon}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Services & Event Logs -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Services Manager -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Service Manager" Style="{StaticResource SectionTitle}" />
                            <Button Content="Refresh" HorizontalAlignment="Right"
                                    Command="{Binding LoadServicesCommand}"
                                    Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="12,4"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                        </Grid>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="8" MaxHeight="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding Services}" Background="Transparent"
                                         BorderThickness="0" SelectedItem="{Binding SelectedServiceName}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="12" />
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="10" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding Status}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                                           VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Start" FontSize="10" Padding="6,2" Margin="2,0"
                                                            Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Name}" Background="{StaticResource SuccessBrush}"
                                                            Foreground="White" BorderThickness="0" Cursor="Hand" />
                                                    <Button Content="Stop" FontSize="10" Padding="6,2" Margin="2,0"
                                                            Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Name}" Background="{StaticResource DangerBrush}"
                                                            Foreground="White" BorderThickness="0" Cursor="Hand" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Event Log Analyzer -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Event Log Analyzer (24h)" Style="{StaticResource SectionTitle}" />
                            <Button Content="Analyze" HorizontalAlignment="Right"
                                    Command="{Binding AnalyzeEventLogsCommand}"
                                    Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="12,4"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                        </Grid>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="8" MaxHeight="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding CriticalEvents}" Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10" Margin="0,2">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Type}" HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource DangerBrush}" FontSize="10" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding LogName}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="9" />
                                                        <TextBlock Text="{Binding TimeGenerated}" HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Audit Log -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Audit Log" Style="{StaticResource SectionTitle}" />
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AuditLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

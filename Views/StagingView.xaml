<UserControl x:Class="BhavaniSupportSuite.Views.StagingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:BhavaniSupportSuite.Views"
             mc:Ignorable="d"
             Foreground="{StaticResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Package Installer -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Silent Installer Orchestration" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar Grid.Column="1" Value="{Binding ProgressValue}" Maximum="100"
                                     Width="200" VerticalAlignment="Center" Margin="12,0" Height="4" />

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Install Selected Packages"
                                    Command="{Binding InstallSelectedCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{Binding IsInstalling, Converter={x:Static views:InverseBoolConverter.Instance}}" />
                            <Button Content="Cancel" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}"
                                    Background="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource StatusText}" Margin="0,0,0,12" />

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12">
                        <DataGrid ItemsSource="{Binding Packages}" AutoGenerateColumns="False"
                                  Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderThickness="0" GridLinesVisibility="None"
                                  HeadersVisibility="Column" RowBackground="{StaticResource CardBrush}"
                                  AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay}"
                                                        Width="60" />
                                <DataGridTextColumn Header="Package" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                                <DataGridTextColumn Header="Silent Args" Binding="{Binding SilentArgs}" Width="200" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Registry Tweaks -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Software License &amp; Registry Staging" Style="{StaticResource SectionTitle}" />

                    <Button Content="Apply Selected Registry Tweaks"
                            Command="{Binding ApplyRegistryTweaksCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding IsInstalling, Converter={x:Static views:InverseBoolConverter.Instance}}"
                            HorizontalAlignment="Left" Margin="0,0,0,12" />

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12">
                        <DataGrid ItemsSource="{Binding RegistryTweaks}" AutoGenerateColumns="False"
                                  Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderThickness="0" GridLinesVisibility="None"
                                  HeadersVisibility="Column" RowBackground="{StaticResource CardBrush}"
                                  AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay}"
                                                        Width="60" />
                                <DataGridTextColumn Header="Tweak" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Install Log -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Installation Log" Style="{StaticResource SectionTitle}" />
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" MaxHeight="250">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding InstallLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
